[Unit]
Description=AegisBox Secure Ephemeral Code Execution Engine
After=network.target

[Service]
Type=simple
ExecStart=/opt/aegisbox/bin/aegisbox server -port 8080 -host 0.0.0.0
WorkingDirectory=/opt/aegisbox
Restart=always
RestartSec=3
LimitNOFILE=65536
Environment="AEGISBOX_SERVER_PORT=8080"
Environment="AEGISBOX_ROOTFS_DIR=/opt/aegisbox/rootfs"
Environment="AEGISBOX_WORKSPACE_DIR=/tmp/aegisbox/workspaces"

# Standard logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegisbox

[Install]
WantedBy=multi-user.target
