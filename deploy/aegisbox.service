[Unit]
Description=AegisBox Secure Ephemeral Code Execution Engine
Documentation=https://github.com/fendyramadhani9-cloud/aegisbox
After=network.target

[Service]
Type=simple
ExecStart=/opt/aegisbox/bin/aegisbox server -port 8080 -host 0.0.0.0
WorkingDirectory=/opt/aegisbox
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

# Environment overrides
Environment="AEGISBOX_SERVER_PORT=8080"
Environment="AEGISBOX_ROOTFS_DIR=/opt/aegisbox/rootfs"
Environment="AEGISBOX_WORKSPACE_DIR=/tmp/aegisbox/workspaces"

# Sandboxing and filesystem protection
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# Standard logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegisbox

[Install]
WantedBy=multi-user.target
